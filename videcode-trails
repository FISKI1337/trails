local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

-- ===== НАСТРОЙКИ =====
local CFG = {
	mode    = "bloom",
	count   = 40,    -- частиц в секунду
	size    = 1.0,   -- множитель размера
	back    = 0.7,   -- как далеко за спиной
	life    = 1.0,   -- время жизни (сек), 0.001 - 3
	side    = 3,     -- разлёт в стороны
	color   = Color3.fromRGB(255, 170, 255),
	rainbow = false,
}

local BASE_SIZE = { bloom = 0.45, star = 0.8 }

local COLORS = {
	Color3.fromRGB(255, 170, 255), Color3.fromRGB(255, 255, 150),
	Color3.fromRGB(120, 200, 255), Color3.fromRGB(255, 100, 100),
	Color3.fromRGB(120, 255, 150), Color3.fromRGB(255, 255, 255),
}

local player = Players.LocalPlayer
local container = Instance.new("Folder")
container.Name = "TrailParticles"
container.Parent = workspace.Terrain

local particles = {}

local function spawnParticle(hrp)
	local cf = hrp.CFrame
	local x = (math.random() - 0.5) * 1.6
	local y = (math.random() - 0.5) * 5 - 0.3
	local z = CFG.back + math.random() * 0.2
	local pos = (cf * CFrame.new(x, y, z)).Position

	local att = Instance.new("Attachment")
	att.WorldPosition = pos
	att.Parent = container

	local bb = Instance.new("BillboardGui")
	bb.Adornee = att
	bb.LightInfluence = 0
	bb.Active = false
	bb.Parent = att

	local obj
	if CFG.mode == "bloom" then
		obj = Instance.new("Frame")
		obj.BackgroundColor3 = CFG.color
		obj.BorderSizePixel = 0
		obj.Size = UDim2.fromScale(1, 1)
		Instance.new("UICorner", obj).CornerRadius = UDim.new(0.5, 0)
	else
		obj = Instance.new("TextLabel")
		obj.BackgroundTransparency = 1
		obj.Text = "★"
		obj.TextScaled = true
		obj.Font = Enum.Font.SourceSansBold
		obj.TextColor3 = CFG.color
		obj.Size = UDim2.fromScale(1, 1)
		obj.Rotation = math.random(0, 360)
	end
	obj.Parent = bb

	local s = BASE_SIZE[CFG.mode] * CFG.size
	bb.Size = UDim2.fromScale(s, s)

	local dir = (x >= 0) and cf.RightVector or -cf.RightVector
	table.insert(particles, {
		att = att, bb = bb, obj = obj, mode = CFG.mode,
		pos = pos, size = s, age = 0, life = CFG.life * (0.8 + math.random() * 0.4),
		vel = dir * (CFG.side * (0.3 + math.random() * 0.7)) + Vector3.new(0, 0.3, 0),
		spin = math.random(-120, 120),
	})
end

local function updateParticles(dt)
	for i = #particles, 1, -1 do
		local p = particles[i]
		p.age += dt
		if p.age >= p.life then
			p.att:Destroy()
			table.remove(particles, i)
		else
			local t = p.age / p.life
			p.vel = p.vel * math.max(0, 1 - 3 * dt)
			p.pos += p.vel * dt
			p.att.WorldPosition = p.pos
			local s = p.size * (1 - t * 0.7)
			p.bb.Size = UDim2.fromScale(s, s)
			if p.mode == "bloom" then
				p.obj.BackgroundTransparency = t * t
			else
				p.obj.TextTransparency = t * t
				p.obj.Rotation += p.spin * dt
			end
		end
	end
end

local hrpCur, acc, hue = nil, 0, 0

local function setup(char)
	hrpCur = char:WaitForChild("HumanoidRootPart")
end

RunService.Heartbeat:Connect(function(dt)
	updateParticles(dt)
	if not hrpCur or not hrpCur.Parent then return end

	if CFG.rainbow then
		hue = (hue + dt * 0.3) % 1
		CFG.color = Color3.fromHSV(hue, 0.7, 1)
	end

	if hrpCur.AssemblyLinearVelocity.Magnitude > 0.5 then
		acc += CFG.count * dt
		while acc >= 1 do
			acc -= 1
			spawnParticle(hrpCur)
		end
	else
		acc = 0
	end
end)

