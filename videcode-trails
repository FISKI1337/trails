-- слайдеры
local dragging = nil

local function slider(name, key, min, max, step, fmt)
	local holder = Instance.new("Frame")
	holder.LayoutOrder = nextOrder()
	holder.Size = UDim2.new(1, 0, 0, 40)
	holder.BackgroundTransparency = 1
	holder.Parent = frame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 16)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.Gotham
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = holder

	local hit = Instance.new("Frame") -- увеличенная зона нажатия
	hit.Position = UDim2.fromOffset(0, 18)
	hit.Size = UDim2.new(1, 0, 0, 20)
	hit.BackgroundTransparency = 1
	hit.Parent = holder

	local track = Instance.new("Frame")
	track.AnchorPoint = Vector2.new(0, 0.5)
	track.Position = UDim2.fromScale(0, 0.5)
	track.Size = UDim2.new(1, 0, 0, 6)
	track.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
	track.BorderSizePixel = 0
	track.Parent = hit
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Color3.fromRGB(170, 130, 255)
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(0, 1)
	fill.Parent = track
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Size = UDim2.fromOffset(14, 14)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.BorderSizePixel = 0
	knob.Parent = track
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local function refresh()
		local a = (CFG[key] - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		label.Text = name .. ": " .. fmt(CFG[key])
	end

	local function setFromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local v = min + (max - min) * a
		v = math.floor(v / step + 0.5) * step
		CFG[key] = math.clamp(v, min, max)
		refresh()
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = { set = setFromX }
			setFromX(input.Position.X)
		end
	end)

	refresh()
end

UIS.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		dragging.set(input.Position.X)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = nil
	end
end)

local function fmtTime(v)
	if v < 1 then return string.format("%d мс", math.floor(v * 1000 + 0.5)) end
	return string.format("%.2f с", v)
end

slider("Размер",  "size",  0.25, 5,   0.05,  function(v) return string.format("%.2f", v) end)
slider("Кол-во",  "count", 5,    200, 1,     function(v) return string.format("%d", v) end)
slider("Назад",   "back",  0.2,  3,   0.05,  function(v) return string.format("%.2f", v) end)
slider("Разлёт",  "side",  0,    10,  0.1,   function(v) return string.format("%.1f", v) end)
slider("Время",   "life",  0.001, 3,  0.001, fmtTime)

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.G then gui.Enabled = not gui.Enabled end
end)

if player.Character then setup(player.Character) end
player.CharacterAdded:Connect(setup)
